{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "AIF 桌面客户端默认权限",
  "windows": ["main", "login", "conversation", "*"],
  "remote": {
    "urls": ["*://*"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-start-dragging",
    "core:webview:default",
    "core:event:default",
    "notification:default",
    "log:default",
    "allow-account-delete",
    "allow-account-list",
    "allow-account-save",
    "allow-capture-session",
    "allow-check-captcha-required",
    "allow-check-now",
    "allow-close-webview-self",
    "allow-debug-dump",
    "allow-debug-webview-rect",
    "allow-fire-snooze",
    "allow-get-ai-agents",
    "allow-get-app-version",
    "allow-get-captcha",
    "allow-get-credential-hint",
    "allow-get-docs",
    "allow-get-matters",
    "allow-get-message-history",
    "allow-get-messages",
    "allow-get-ops-apps",
    "allow-get-quick-entries",
    "allow-get-roles",
    "allow-get-settings",
    "allow-get-spaces",
    "allow-get-todos",
    "allow-get-user-info",
    "allow-is-logged-in",
    "allow-layout-full",
    "allow-layout-mini",
    "allow-login-local",
    "allow-login-qr",
    "allow-login-webview",
    "allow-logout",
    "allow-mark-todo-done",
    "allow-open-conversation",
    "allow-open-external",
    "allow-poll-qr",
    "allow-quit-app",
    "allow-reflow-main-webview",
    "allow-report-requests",
    "allow-save-settings",
    "allow-set-autostart",
    "allow-set-hotkey",
    "allow-set-mini-card-visible",
    "allow-switch-role",
    "allow-toggle-mini-bar",
    "allow-trace-invoke",
    "allow-try-auto-login",
    "allow-start",
    "allow-sync-tabs-on-resize",
    "allow-tab-activate",
    "allow-tab-bounds",
    "allow-tab-close",
    "allow-tab-close-all",
    "allow-tab-close-others",
    "allow-tab-close-self",
    "allow-tab-hide-all",
    "allow-tab-list-cmd",
    "allow-tab-navigate",
    "allow-tab-open",
    "allow-tab-reload",
    "allow-tab-report-title",
    "allow-tab-restore-all",
    "allow-tab-restore-session"
  ]
}
